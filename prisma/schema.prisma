// Control Room — persistence layer.
//
// The models below mirror src/lib/types.ts one-for-one so the client store can be
// serialised to the API and back with no field-name translation. Enum *values* are
// lowercase for the same reason: they are the exact strings the TypeScript unions use.
//
// Every app row is scoped by userId and cascades from User, so deleting an account
// leaves nothing behind. Primary keys are the ids the client already generates —
// that is what lets an offline store be pushed up wholesale via /api/sync.

generator client {
  provider = "prisma-client-js"
  // "native" covers local development; Vercel's Node runtime is Amazon Linux
  // with OpenSSL 3.0, and without that target the engine binary is absent in
  // the deployed function and PrismaClient throws on construction.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  // Supabase pooler pattern: the app talks to pgbouncer (DATABASE_URL), while
  // migrations need a direct, non-pooled connection (DIRECT_URL).
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) — shapes required by @auth/prisma-adapter
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  categories Category[]
  tasks      Task[]
  goals      Goal[]
  log        LogEntry[]
  xpEvents   XpEvent[]
  profile    Profile?
  streak     Streak?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  // Google's offline refresh token lives here; it is the only durable credential
  // we hold, and the access token is rotated against it in src/lib/auth.ts.
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Application data
// ---------------------------------------------------------------------------

enum Quadrant {
  q1
  q2
  q3
  q4
}

enum TaskStatus {
  open
  done
  skipped
}

model Category {
  id                String   @id
  userId            String
  name              String
  short             String
  // One of the six functional swatches (amber/clay/olive/teal/steel/plum). Kept a
  // String rather than an enum so the palette can grow without a migration.
  color             String
  weeklyTargetHours Float
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
  goals Goal[]

  @@index([userId])
}

model Task {
  id             String     @id
  userId         String
  title          String
  categoryId     String
  quadrant       Quadrant
  estimateMin    Int
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  // Google Calendar event id, set once the block has been written out.
  calendarEventId String?
  status         TaskStatus @default(open)
  completedAt    DateTime?
  actualMin      Int?
  goalId         String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  goal     Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, scheduledStart])
  @@index([userId, status])
  @@index([categoryId])
  @@index([goalId])
}

model Goal {
  id         String    @id
  userId     String
  title      String
  categoryId String
  target     Float
  current    Float     @default(0)
  unit       String
  due        DateTime?
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([userId])
  @@index([categoryId])
}

model LogEntry {
  id     String @id
  userId String
  // YYYY-MM-DD in the user's local time, not a timestamp: "which day did this
  // belong to" is a local-calendar question and must not shift with the server TZ.
  date   String
  body   String
  energy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One entry per day is what earns XP, so the database enforces it.
  @@unique([userId, date])
  @@index([userId])
}

model Profile {
  id               String  @id @default(cuid())
  userId           String  @unique
  name             String
  weekStartsOn     Int     @default(1)
  dayStartHour     Int     @default(7)
  dayEndHour       Int     @default(23)
  remindersEnabled Boolean @default(true)
  remindLeadMin    Int     @default(10)
  calendarConnected Boolean @default(false)
  calendarId       String?
  // Lifetime XP total. It lives on the profile because it is a single per-user
  // scalar, and XpEvent is only the recent-activity feed, not the ledger of record.
  xp               Int     @default(0)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model XpEvent {
  id     String   @id
  userId String
  at     DateTime
  amount Int
  // "task" | "log" | "goal"
  kind   String
  label  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, at])
}

model Streak {
  id             String   @id @default(cuid())
  userId         String   @unique
  current        Int      @default(0)
  longest        Int      @default(0)
  freezesUsed    Int      @default(0)
  freezesPerWeek Int      @default(2)
  // YYYY-MM-DD, local — same reasoning as LogEntry.date.
  lastActiveDate String?
  frozenDates    String[] @default([])

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
