# Control Room — every variable is optional. With none of them set the app still
# runs: the UI works entirely against the local zustand store, and the API routes
# report that persistence / Google are not configured instead of failing.

# Pooled Postgres connection used at runtime (Supabase: the :6543 pgbouncer URL,
# with ?pgbouncer=true&connection_limit=1).
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct, non-pooled connection on :5432 — Prisma migrate and db push need it.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# NextAuth v4 name for the same value; set either one (AUTH_SECRET wins).
NEXTAUTH_SECRET=""

# Canonical origin of the deployment, used to build OAuth callback URLs.
AUTH_URL="http://localhost:3000"

# Google OAuth client id — Google Cloud console, Web application credentials.
GOOGLE_CLIENT_ID=""

# Google OAuth client secret, from the same credential.
GOOGLE_CLIENT_SECRET=""
